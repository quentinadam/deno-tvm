{
  "name": "@quentinadam/tvm",
  "version": "0.2.1",
  "description": "TVM library",
  "license": "MIT",
  "author": "Quentin Adam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinadam/deno-tvm.git"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@quentinadam/assert": "jsr:@quentinadam/assert@^0.1.18",
    "@quentinadam/base58check": "jsr:@quentinadam/base58check@^0.1.16",
    "@quentinadam/evm-base": "jsr:@quentinadam/evm-base@^0.3.1",
    "@quentinadam/hash": "jsr:@quentinadam/hash@^0.1.16",
    "@quentinadam/secp256k1": "jsr:@quentinadam/secp256k1@^0.1.7",
    "@quentinadam/uint8array-extension": "jsr:@quentinadam/uint8array-extension@^0.1.19",
    "@quentinadam/zod": "jsr:@quentinadam/zod@^0.2.4",
    "typescript": "npm:typescript@^7.0.2"
  },
  "minimumDependencyAge": {
    "exclude": [
      "jsr:@quentinadam/*",
      "npm:@quentinadam/*"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 120
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true
  }
}
